r=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1105" y="590" width="410" height="68" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c5" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c19" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c21" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c22" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Правила эволюции (чтобы проект жил годами)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F1F5F9;strokeColor=#475569;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="715" width="1480" height="240" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Semver для контрактов&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;breaking change = новая мажорная версия + период совместимости&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="85" y="770" width="266" height="150" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Contract tests&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;каждый плагин обязан проходить тесты контракта&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="375" y="770" width="266" height="150" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;ADR&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;любое изменение ядра — короткая запись «почему»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="665" y="770" width="266" height="150" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Модульный монолит&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;сначала один процесс, границы — как у сервисов&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="955" y="770" width="266" height="150" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Изоляция плагинов&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;отдельный процесс • манифест прав • least privilege&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1245" y="770" width="266" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="03 — Жизненный цикл задачи"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1080" math="0" shadow="0" background="#F8FAFC"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;03 — Жизненный цикл задачи&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F8FAFC;strokeColor=#F8FAFC;fontSize=28;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1520" height="44" as="geometry"/></mxCell><mxCell id="c3" value="Два пути: fast path для простого (задержка) и full path для сложного (качество). Проверка пропорциональна риску." style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F8FAFC;strokeColor=#F8FAFC;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="1520" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Envelope&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569'&gt;принципал • источник • trust&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="125" width="300" height="80" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Router&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569'&gt;простая команда или задача?&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="420" y="125" width="300" height="80" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;FAST PATH — «включи свет», «сколько времени», типовые команды&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F0FDFA;strokeColor=#0D9488;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="235" width="1480" height="140" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Skill / Reflex&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;шаблон известной команды&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#0D9488;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="285" width="337" height="75" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Policy check&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;PDP: уровень риска&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#0D9488;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="447" y="285" width="337" height="75" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Tool call&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;через Tool Port&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#0D9488;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="814" y="285" width="337" height="75" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Result + Audit&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;без Planner и Verifier&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;