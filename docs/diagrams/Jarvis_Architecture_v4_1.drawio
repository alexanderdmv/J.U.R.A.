span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="670" width="268" height="100" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Изменение&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;промпт • модель • router • политика • skill&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="372" y="670" width="268" height="100" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Прогон suite&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;автоматически&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="664" y="670" width="268" height="100" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Сравнение с baseline&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;качество • цена • безопасность&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="956" y="670" width="268" height="100" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Gate&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;регрессия безопасности блокирует&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1248" y="670" width="268" height="100" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Улучшение — по порядку реалистичности&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F1F5F9;strokeColor=#475569;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="820" width="1480" height="190" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;1. Skills, playbooks, промпты&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;быстрый и дешёвый выигрыш&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="875" width="337" height="115" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;2. Память и правила Router&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;на основе метрик&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="447" y="875" width="337" height="115" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;3. LoRA / дообучение (позже)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;только на verified данных&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="814" y="875" width="337" height="115" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Guardrails&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;prod не меняет себя • core/security — только с человеком&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1181" y="875" width="337" height="115" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="08 — Автономность"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1060" math="0" shadow="0" background="#F8FAFC"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;08 — Автономность: Initiative Engine&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F8FAFC;strokeColor=#F8FAFC;fontSize=28;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1520" height="44" as="geometry"/></mxCell><mxCell id="c3" value="Jarvis сам инициирует задачи, но только в рамках явных разрешений. Без разрешения он предлагает, а не действует." style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F8FAFC;strokeColor=#F8FAFC;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="1520" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Источники инициативы&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F5F3FF;strokeColor=#7C3AED;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="125" width="1480" height="145" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Расписание&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;утренняя сводка, регулярные проверки&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#7C3AED;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="180" width="337" height="75" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;События&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;новое письмо • упал CI • движение курса&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#7C3AED;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="447" y="180" width="337" height="75" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Мониторы&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;условия: дедлайн, баланс, лимиты&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#7C3AED;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="814" y="180" width="337" height="75" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Наблюдения Jarvis&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;замечает паттерны и предлагает&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#7C3AED;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1181" y="180" width="337" height="75" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Initiative Engine&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="295" width="1480" height="150" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Триггер&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;с принципалом и уровнем доверия&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="350" width="264" height="75" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Standing Orders&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;есть ли явное разрешение?&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="374" y="350" width="264" height="75" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Важность и срочность&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;стоит ли отвлекать&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="668" y="350" width="264" height="75" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Attention budget&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;тихие часы • лимит уведомлений&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="962" y="350" width="264" height="75" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Решение&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;suggest • prepare • act&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1256" y="350" width="264" height="75" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Уровни автономности (задаются по доменам: почта, код, календарь, финансы)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#ECFDF5;strokeColor=#059669;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="1480" height="190" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;A0 — Suggest&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;только предлагает&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="525" width="337" height="115" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;A1 — Prepare&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;готовит черновик, PR, план — ждёт тебя&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="447" y="525" width="337" height="115" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;A2 — Act + notify&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;делает и сообщает, откат возможен&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="814" y="525" width="337" height="115" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;A3 — Act silently&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;только безопасное и обратимое&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1181" y="525" width="337" height="115" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Standing Orders — явные, версионируемые, отзываемые разрешения&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="685" width="1480" height="170" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Формат&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;«если X, то Y, в пределах Z»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="740" width="337" height="95" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Срок и отзыв&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;истекают, отзываются одной командой&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="447" y="740" width="337" height="95" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Нет order → только suggest&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;инициатива без разрешения не исполняется&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="814" y="740" width="337" height="95" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Повышение уровня&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;по метрикам evals, решение принимает человек&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1181" y="740" width="337" height="95" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Защитные механизмы&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FEF2F2;strokeColor=#DC2626;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="880" width="1480" height="160" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Kill switch&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;глобальная пауза одной командой&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="930" width="337" height="95" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Rate limits&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;на число автономных действий&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="447" y="930" width="337" height="95" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Audit со ссылкой на order&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;видно, почему он это сделал&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="814" y="930" width="337" height="95" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Недоверенный триггер&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;письмо не может расширить права&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1181" y="930" width="337" height="95" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p8" name="09 — Зоны данных и железо"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0" background="#F8FAFC"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;09 — Зоны данных, приватность и железо&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F8FAFC;strokeColor=#F8FAFC;fontSize=28;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1520" height="44" as="geometry"/></mxCell><mxCell id="c3" value="Секретное не покидает твоё железо. Всё остальное можно отдавать облаку, но только через контролируемый выход." style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F8FAFC;strokeColor=#F8FAFC;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="1520" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Зоны данных (примеры — не определение; зона задаётся правилами ниже)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FEF2F2;strokeColor=#DC2626;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="125" width="1480" height="215" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;ZONE S2 — Credentials&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;ключи • токены • recovery key&lt;br/&gt;модель НЕ видит, только детерминированный tool&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="180" width="342" height="140" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;ZONE S1 — Sensitive&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;финансы • здоровье • личные документы&lt;br/&gt;только локальные модели&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="446" y="180" width="342" height="140" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;ZONE P — Private&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;код • почта • календарь&lt;br/&gt;облако только через Redaction Gateway&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="812" y="180" width="342" height="140" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;ZONE O — Open&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;публичное, общие вопросы&lt;br/&gt;облако свободно&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1178" y="180" width="342" height="140" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Redaction Gateway — единственный выход наружу&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="365" width="1480" height="150" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Запрос&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;с метками источников&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="420" width="264" height="75" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Классификатор&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;метки + правила + secret scanning&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="374" y="420" width="264" height="75" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Маскировка&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;обратимые плейсхолдеры&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="668" y="420" width="264" height="75" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Egress log&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;что именно ушло наружу&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="962" y="420" width="264" height="75" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Облако&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;ответ → обратная подстановка&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1256" y="420" width="264" height="75" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Железо — по стадиям (интерфейсы не меняются)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#ECFDF5;strokeColor=#059669;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="1480" height="185" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;H0 — сейчас&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;рабочий ПК: разработка, без реальных секретов&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="595" width="342" height="110" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;H1 — Core-сервер&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;всегда включён • шифрование диска • TPM • отдельно от повседневного ПК&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="446" y="595" width="342" height="110" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;H2 — GPU-узел&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;локальные модели для зоны S (ключевое — объём VRAM)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="812" y="595" width="342" height="110" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;H3 — усиление&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;YubiKey/FIDO2 • аппаратные ключи • сегментация сети&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1178" y="595" width="342" height="110" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Модель угроз — от чего защищаемся&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F1F5F9;strokeColor=#475569;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="750" width="1480" height="200" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Кража устройства&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;шифрование диска, ключ не хранится на диске&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="805" width="342" height="125" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Malware на рабочем ПК&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;Core не на повседневной машине • песочницы&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="446" y="805" width="342" height="125" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Облачный провайдер&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;зона S не уходит • маскировка • egress log&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="812" y="805" width="342" height="125" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Удалённый атакующий&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;mTLS • минимум открытых портов • только VPN&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1178" y="805" width="342" height="125" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Как присваивается зона&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;default policy + явные метаданные + политика источника + user override; производное наследует максимальную метку&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="975" width="725" height="75" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Маскировка несовершенна&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;поэтому S — default deny, а не «разрешено, если не нашли секрет»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="815" y="975" width="725" height="75" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p9" name="10 — Голос"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="930" math="0" shadow="0" background="#F8FAFC"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;10 — Голосовой контур&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F8FAFC;strokeColor=#F8FAFC;fontSize=28;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1520" height="44" as="geometry"/></mxCell><mxCell id="c3" value="Голос — удобный канал, но не способ авторизации. Всё тяжёлое — на Core/GPU-узле, на устройстве только звук." style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F8FAFC;strokeColor=#F8FAFC;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="1520" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Конвейер&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="125" width="1480" height="160" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Wake word&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;на устройстве&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#7C3AED;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="180" width="221" height="80" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;VAD + запись&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;на устройстве&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#7C3AED;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="323" y="180" width="221" height="80" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;STT (stream)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;локально&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="566" y="180" width="221" height="80" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Router / Fast Path&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;как в текстовом пути&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="809" y="180" width="221" height="80" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Ответ&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;Kernel → Runtime&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1052" y="180" width="221" height="80" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;TTS (stream)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;локально или облако (по зоне)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1295" y="180" width="221" height="80" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Требования&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#ECFDF5;strokeColor=#059669;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="1480" height="170" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Latency&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;fast path: ответ начинается меньше чем за секунду&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="365" width="337" height="95" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Barge-in&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;можно перебить на полуслове&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="447" y="365" width="337" height="95" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Speaker verification&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;удобство, не безопасность&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="814" y="365" width="337" height="95" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Голос не авторизует L2/L3&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;подтверждение — на доверенном устройстве или ключом&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1181" y="365" width="337" height="95" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Где что выполняется&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F1F5F9;strokeColor=#475569;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="505" width="1480" height="170" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Устройство&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;wake word • VAD • аудио ввод-вывод&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="560" width="337" height="95" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Core / GPU-узел&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;STT • Router • LLM&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="447" y="560" width="337" height="95" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;TTS&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;локально (зона S/P) или облако (зона O)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="814" y="560" width="337" height="95" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Fallback&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;нет голоса → текст, Core продолжает работать&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1181" y="560" width="337" height="95" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Угрозы голосового канала&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FEF2F2;strokeColor=#DC2626;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="1480" height="190" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Replay / синтез голоса&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;не полагаться на голос для прав&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="755" width="337" height="105" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Посторонние в комнате&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;приватные ответы не озвучивать без режима&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="447" y="755" width="337" height="105" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Ложные срабатывания&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;порог wake word + подтверждение опасного&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="814" y="755" width="337" height="105" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Секреты вслух&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;зона S не озвучивается&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1181" y="755" width="337" height="105" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p10" name="11 — Финансовый контур"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1010" math="0" shadow="0" background="#F8FAFC"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;11 — Финансовый контур (Finance Enclave)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F8FAFC;strokeColor=#F8FAFC;fontSize=28;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1520" height="44" as="geometry"/></mxCell><mxCell id="c3" value="Реальные деньги = самый строгий контур. LLM предлагает, детерминированный код ограничивает, человек подтверждает." style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F8FAFC;strokeColor=#F8FAFC;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="1520" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Принципы&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FEF2F2;strokeColor=#DC2626;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="125" width="1480" height="150" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Отдельный процесс&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;свои креды, своя политика&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="180" width="460" height="75" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;LLM не отправляет ордер&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;только структурированное предложение&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="570" y="180" width="460" height="75" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Защита у провайдера&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;лимиты и права на стороне биржи/банка&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="180" width="460" height="75" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Поток действия&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="1480" height="180" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Agent&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;предлагает действие&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="355" width="221" height="95" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Предложение&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;структура: тип, сумма, инструмент&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="323" y="355" width="221" height="95" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Risk Engine&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;детерминированно: лимиты, allowlist&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="566" y="355" width="221" height="95" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Подтверждение&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;YubiKey touch (L3)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="809" y="355" width="221" height="95" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Finance Enclave&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;исполняет&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1052" y="355" width="221" height="95" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Биржа / банк&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;результат → audit&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1295" y="355" width="221" height="95" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Биржи&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="505" width="1480" height="195" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Ключи только trade&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;без права вывода&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="560" width="272" height="110" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;IP whitelist&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;ключ работает только с Core&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="372" y="560" width="272" height="110" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Sub-account&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;ограниченная сумма&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="664" y="560" width="272" height="110" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Лимиты&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;позиция • дневной убыток • kill&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="956" y="560" width="272" height="110" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Автоторговля&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;по детерминированной стратегии, не по решению LLM в реальном времени&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1248" y="560" width="272" height="110" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Банки&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#ECFDF5;strokeColor=#059669;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="725" width="1480" height="190" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Этап 1 — read-only&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;чтение счетов (open banking, где доступно)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="780" width="337" height="110" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Этап 2 — подготовка&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;Jarvis готовит платёж&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="447" y="780" width="337" height="110" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Подтверждение&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;в приложении банка, не в Jarvis&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="814" y="780" width="337" height="110" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Автономные платежи&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;запрещены по умолчанию; включение = L3-изменение политики + лимиты у банка&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1181" y="780" width="337" height="110" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Юридические и налоговые аспекты проверяй отдельно&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#475569'&gt;это архитектурный набросок, не финансовая консультация&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="935" width="1480" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p11" name="12 — Roadmap v3"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1130" math="0" shadow="0" background="#F8FAFC"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;12 — Roadmap v3: под твои цели&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F8FAFC;strokeColor=#F8FAFC;fontSize=28;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1520" height="44" as="geometry"/></mxCell><mxCell id="c3" value="Качество важнее скорости: фундамент и тонкий сквозной срез сначала, деньги и автономность в конце." style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F8FAFC;strokeColor=#F8FAFC;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="1520" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Phase 0 — Фундамент + skeleton&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569'&gt;• Контракты, схемы&lt;br/&gt;• Kernel: state machine, event log, audit&lt;br/&gt;• Policy Engine, eval-скелет&lt;br/&gt;• ADR + threat model&lt;br/&gt;• Сбор трейсов и verified-опыта с Day 1 (с учётом зон)&lt;br/&gt;• Тонкий срез: текст → задача → tool → результат&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="70" y="125" width="350" height="250" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Phase 1 — Dev-ассистент&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569'&gt;• Sandbox (worktree/container)&lt;br/&gt;• Verifier на тестах, review gate&lt;br/&gt;• Model Router local + cloud&lt;br/&gt;• Память v1&lt;br/&gt;• Redaction Gateway v0 + secret scanning&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="450" y="125" width="350" height="250" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Phase 2 — Инфраструктура и зона S&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569'&gt;• Core-сервер 24/7&lt;br/&gt;• Vault, бэкапы, restore drill&lt;br/&gt;• mTLS, VPN&lt;br/&gt;• GPU-узел для зоны S (по мере железа)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#7C3AED;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="830" y="125" width="350" height="250" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Phase 3 — Голос&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569'&gt;• Wake word, STT, TTS&lt;br/&gt;• Fast path&lt;br/&gt;• Voice не авторизует L2/L3&lt;br/&gt;• Fallback на текст&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#7C3AED;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="1210" y="125" width="350" height="250" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Phase 4 — Почта и календарь&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569'&gt;• read → draft → act (L2)&lt;br/&gt;• Scoped-гранты&lt;br/&gt;• Защита от prompt injection в письмах&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="70" y="410" width="350" height="250" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Phase 5 — Initiative Engine&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569'&gt;• Standing Orders&lt;br/&gt;• A0 → A1 → A2 по доменам&lt;br/&gt;• Attention budget, kill switch&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="450" y="410" width="350" height="250" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Phase 6 — Финансы: чтение&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569'&gt;• Банк read-only&lt;br/&gt;• Биржа read-only&lt;br/&gt;• Аналитика без права действовать&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="830" y="410" width="350" height="250" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Phase 7 — Финансы: действия&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569'&gt;• Finance Enclave&lt;br/&gt;• YubiKey, trade-only sub-account&lt;br/&gt;• Risk Engine, лимиты у провайдера&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="1210" y="410" width="350" height="250" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c7" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Phase 8 — Самоулучшение&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569'&gt;• Skills и playbooks на проверенном опыте&lt;br/&gt;• Бенчмарки как ворота, кандидат → тест → promote&lt;br/&gt;• Обучение моделей — только потом; данные зоны S — только локально&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="70" y="695" width="710" height="170" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Сознательно отложено&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569'&gt;• Автономные платежи — запрещены по умолчанию&lt;br/&gt;• HA-кластер — если реально понадобится&lt;br/&gt;• Сложные мультиагентные схемы&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="820" y="695" width="710" height="170" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c14" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Всегда, с первого дня&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F1F5F9;strokeColor=#475569;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="895" width="1480" height="210" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;ADR&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;журнал решений&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="950" width="268" height="135" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Threat model&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;обновляется с каждой фазой&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="372" y="950" width="268" height="135" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Evals + experience store&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;трейсы и verified-опыт с Day 1&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="664" y="950" width="268" height="135" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Backups + restore drill&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;проверять восстановление&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="956" y="950" width="268" height="135" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Contract tests&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;на каждый плагин&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1248" y="950" width="268" height="135" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p12" name="13 — Очередь ADR"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1040" math="0" shadow="0" background="#F8FAFC"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;13 — Очередь ADR: что решить до кода&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F8FAFC;strokeColor=#F8FAFC;fontSize=28;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1520" height="44" as="geometry"/></mxCell><mxCell id="c3" value="Диаграмм достаточно. Следующий артефакт — короткие ADR с альтернативами, затем walking skeleton." style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F8FAFC;strokeColor=#F8FAFC;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="1520" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Решить ДО walking skeleton — определяют границы&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FEF2F2;strokeColor=#DC2626;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="125" width="1480" height="295" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;ADR-000 Язык и стек&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;ждёт ответа: на чём ты пишешь уверенно&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="180" width="342" height="100" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;ADR-001 Storage ownership&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;Postgres = состояние, Event Log = история&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="446" y="180" width="342" height="100" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;ADR-002 Task/Event schemas&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;черновик v0 в skeleton, заморозка после&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="812" y="180" width="342" height="100" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;ADR-003 Authorization + policy&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;принципал + устройство + auth; кто меняет политики; default = forbidden&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1178" y="180" width="342" height="100" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;ADR-004 Transaction / outbox&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;согласованность состояния и внешних эффектов&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="295" width="464" height="100" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;ADR-005 Классификация данных&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;шкала O/P/S1/S2, наследование, override&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="568" y="295" width="464" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;ADR-006 Model / Tool contracts&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;черновик v0 + capability descriptor&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1056" y="295" width="464" height="100" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Минимальное решение сейчас, детали — по опыту skeleton&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="445" width="1480" height="175" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;ADR-007 Plugin isolation&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;старт: граница процесса + манифест прав&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="500" width="342" height="100" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;ADR-008 Key hierarchy&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;схема уровней сейчас, реализация в Phase 2&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="446" y="500" width="342" height="100" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;ADR-009 Event versioning&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;schema_version с первого дня, upcasting позже&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="812" y="500" width="342" height="100" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;ADR-010 Trace &amp; experience&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;что логируем с учётом зон (S2 — никогда)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1178" y="500" width="342" height="100" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Решить в своей фазе — реализация&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F1F5F9;strokeColor=#475569;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="645" width="1480" height="175" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Ротация ключей&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;Phase 2&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="700" width="268" height="100" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Безопасные обновления&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;подпись, откат • Phase 2&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="372" y="700" width="268" height="100" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Миграции БД&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;Phase 0–1&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="664" y="700" width="268" height="100" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Формат экспорта памяти&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;Phase 1&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="956" y="700" width="268" height="100" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;STT / TTS / модели&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;Phase 3&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1248" y="700" width="268" height="100" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Порядок работы&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="845" width="1480" height="170" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;ADR (proposed)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;коротко, с альтернативами&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="895" width="330" height="90" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Walking skeleton&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;проверяет границы на практике&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="450" y="895" width="330" height="90" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Пересмотр ADR&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;по опыту skeleton&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="820" y="895" width="330" height="90" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Заморозка контрактов v1&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;дальше только через ADR&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1190" y="895" width="330" height="90" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>