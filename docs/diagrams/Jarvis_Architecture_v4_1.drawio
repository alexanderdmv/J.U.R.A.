gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="324" y="455" width="220" height="100" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Plan-level policy&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;бюджет • риск • нужно ли подтверждение&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="568" y="455" width="220" height="100" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Execute&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;по шагам • checkpoint • PEP на каждый tool&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="812" y="455" width="220" height="100" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Verify&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;тест • правило • ревью • человек&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1056" y="455" width="220" height="100" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Result&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;ответ + запись опыта&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1300" y="455" width="220" height="100" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="PASS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Self-correction&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;FAIL → причина → новый план (макс. N попыток, в рамках бюджета)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="540" y="585" width="460" height="65" as="geometry"/></mxCell><mxCell id="c28" value="FAIL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;end