ue="&lt;b&gt;Гарантии durable execution&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F1F5F9;strokeColor=#475569;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="860" width="1480" height="170" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Checkpoint&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;после каждого шага — можно продолжить после сбоя&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="910" width="268" height="95" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;Idempotency keys&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;повтор не отправит письмо дважды&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="372" y="910" width="268" height="95" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Budgets&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;токены • деньги • время • число шагов&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="664" y="910" width="268" height="95" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;Cancel / timeout / resume&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;любая задача останавливается и возобновляется&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="956" y="910" width="268" height="95" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Transactional outbox&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;состояние, событие и внешний эффект — атомарно&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1248" y="910" width="268" height="95" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="04 — Безопасность"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1060" math="0" shadow="0" background="#F8FAFC"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;04 — Безопасность: принципалы, метки, проверка каждого вызова&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F8FAFC;strokeColor=#F8FAFC;fontSize=28;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1520" height="44" as="geometry"/></mxCell><mxCell id="c3" value="Защита не зависит от «доброй воли» модели. Недоверенный контент не может сам запускать опасные действия." style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F8FAFC;strokeColor=#F8FAFC;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="1520" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Принципалы — кто на самом деле инициирует действие&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F5F3FF;strokeColor=#7C3AED;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="125" width="1480" height="145" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;User principal&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;права = принципал + устройство + уровень auth + действие&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#7C3AED;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="180" width="337" height="75" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Jarvis (автономно)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;ограниченные права, всё в audit&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#7C3AED;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="447" y="180" width="337" height="75" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Trigger&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;cron / webhook — права заданы заранее&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#7C3AED;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="814" y="180" width="337" height="75" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Внешний контент&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;письма • web • файлы — НЕДОВЕРЕННЫЙ&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1181" y="180" width="337" height="75" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Метки данных — ставятся на источнике, а не угадываются моделью&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="295" width="1480" height="155" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Trust&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;TRUSTED • USER • UNTRUSTED&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="350" width="337" height="80" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Sensitivity&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;единая шкала: O • P • S1 • S2 (см. стр. 9)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="447" y="350" width="337" height="80" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Taint rule&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;UNTRUSTED в контексте → L2+ только с подтверждением&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="814" y="350" width="337" height="80" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Context Firewall&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;S1 → только локальные модели • S2 → модель не видит, только tool&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1181" y="350" width="337" height="80" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Проверка КАЖДОГО вызова инструмента (не только на этапе плана)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="475" width="1480" height="215" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Agent&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;предлагает вызов&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="530" width="218" height="100" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Tool Port (PEP)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;обязательная точка контроля&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="324" y="530" width="218" height="100" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Policy Engine (PDP)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;принципал • устройство • уровень auth • tool • аргументы • taint • бюджет&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="568" y="530" width="218" height="100" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Approval / Step-up&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;новая аутентификация или заранее выданный грант&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="812" y="530" width="218" height="100" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Connector&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;секрет подставляется здесь&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1056" y="530" width="218" height="100" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Внешний сервис&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;результат → Event Log&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1300" y="530" width="218" height="100" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Secret Vault&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#475569'&gt;модель ключей никогда не видит&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="648" width="340" height="40" as="geometry"/></mxCell><mxCell id="c27" value="ключ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;dashed=1;" edge="1" parent="1" source="c26" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Уровни риска и гранты&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FEF2F2;strokeColor=#DC2626;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="715" width="1480" height="300" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;L0 — чтение&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;авто&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="770" width="337" height="110" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;L1 — обратимое локальное&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;авто + audit&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="447" y="770" width="337" height="110" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;L2 — внешняя запись&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;подтверждение или scoped-грант&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="814" y="770" width="337" height="110" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;L3 — деньги • замки • необратимое&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;новая сильная аутентификация, даже если команду дал ты&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1181" y="770" width="337" height="110" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Гранты&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;ограниченные по действию, объёму и времени — против усталости от «Approve»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="905" width="460" height="90" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Финансы — отложены&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;лимиты и запрет вывода на стороне провайдера, не только в Jarvis&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="570" y="905" width="460" height="90" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Политики как код&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;версии, тесты; изменение политики = L3-операция&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="905" width="460" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="05 — Память"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1060" math="0" shadow="0" background="#F8FAFC"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;05 — Память: происхождение, уверенность, жизненный цикл&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F8FAFC;strokeColor=#F8FAFC;fontSize=28;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1520" height="44" as="geometry"/></mxCell><mxCell id="c3" value="Память — не «свалка векторов». У каждого факта есть источник, метки, уверенность и срок жизни." style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F8FAFC;strokeColor=#F8FAFC;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="1520" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Memory Port&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569'&gt;write • query • supersede • forget • export&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="540" y="125" width="520" height="75" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Типы памяти&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="225" width="1480" height="150" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Working&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;текущая задача&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="280" width="268" height="80" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Episodic&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;что происходило (из Event Log)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="372" y="280" width="268" height="80" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Semantic&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;факты с источником и уверенностью&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="664" y="280" width="268" height="80" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Procedural&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;skills • playbooks&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="956" y="280" width="268" height="80" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Project&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;решения • репо • issues&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1248" y="280" width="268" height="80" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Запись&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#ECFDF5;strokeColor=#059669;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="1480" height="140" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Ingest&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;источник + provenance&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="450" width="264" height="75" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Метки&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;наследуются от источника&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="374" y="450" width="264" height="75" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Кандидат&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;не факт, пока не проверен&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeomet