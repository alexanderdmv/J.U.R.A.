<mxfile host="app.diagrams.net" version="24.7.17" type="device" compressed="false"><diagram id="p0" name="01 — Обзор (v4.1)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1150" math="0" shadow="0" background="#F8FAFC"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;01 — Общая архитектура v4.1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F8FAFC;strokeColor=#F8FAFC;fontSize=28;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1520" height="44" as="geometry"/></mxCell><mxCell id="c3" value="Принцип: маленькое стабильное ядро (Kernel) + изменяемая логика (Runtime) + заменяемые реализации (Adapters). Зависимости идут только внутрь, к контрактам." style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F8FAFC;strokeColor=#F8FAFC;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="1520" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;1. Узлы (Nodes) — клиенты И провайдеры возможностей устройства&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F5F3FF;strokeColor=#7C3AED;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="125" width="1480" height="145" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Desktop node&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569'&gt;Windows • UI • shell • files&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#7C3AED;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="75" y="180" width="274" height="75" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Mobile node&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569'&gt;mic • camera • push • GPS&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#7C3AED;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="369" y="180" width="274" height="75" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Room / Voice node&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569'&gt;wake word • mic • speaker&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#7C3AED;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="663" y="180" width="274" height="75" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Web / CLI&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569'&gt;dashboard • терминал&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#7C3AED;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="957" y="180" width="274" height="75" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Triggers&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569'&gt;cron • webhooks • события&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#7C3AED;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="1251" y="180" width="274" height="75" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569'&gt;device key + mTLS • сессии • rate limits • Envelope {principal, device, auth level, origin, trust}&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="1480" height="75" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;2. KERNEL — стабильное ядро (меняется редко, только через ADR + contract tests)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="385" width="1480" height="175" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Task State Machine&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;durable • checkpoints • resume&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="75" y="440" width="226" height="100" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Event Log&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;авторитетная история событий&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="319" y="440" width="226" height="100" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Policy Engine (PDP)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;решение allow / ask / deny&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="563" y="440" width="226" height="100" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Audit&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;append-only • tamper-evident • якорь хэша вне Core&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="807" y="440" width="226" height="100" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Scheduler &amp; Budgets&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;tokens • $ • время • шаги&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1051" y="440" width="226" height="100" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Contract Registry&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;версии схем • совместимость&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1295" y="440" width="226" height="100" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;3. RUNTIME — изменчивая логика (часто меняется, живёт за контрактами)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#ECFDF5;strokeColor=#059669;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="1480" height="175" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Router / Fast Path&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;простое — сразу, сложное — в план&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="75" y="635" width="226" height="100" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Intent + Acceptance&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;цель + критерии успеха&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="319" y="635" width="226" height="100" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Planner&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;план как данные (не текст)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="563" y="635" width="226" height="100" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Agent Runtime&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;агент = конфиг: промпт + tools + модель&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="807" y="635" width="226" height="100" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Verifier&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;по типу: тест • правило • ревью • человек&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1051" y="635" width="226" height="100" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Context Builder&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;метки → Context Firewall&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#059669;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1295" y="635" width="226" height="100" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;4. PORTS — контракты, которые знает ядро&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="775" width="1480" height="140" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Model Port&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569'&gt;complete • embed • speech + capability descriptor&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="75" y="825" width="340" height="70" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Memory Port&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569'&gt;write • query • supersede • forget&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="445" y="825" width="340" height="70" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Tool Port (PEP)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569'&gt;обязательная проверка политики&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="815" y="825" width="340" height="70" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Telemetry Port&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569'&gt;trace • metrics • replay&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="1185" y="825" width="340" height="70" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;5. ADAPTERS — заменяемые реализации (плагины)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F1F5F9;strokeColor=#475569;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="935" width="1480" height="140" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Модели&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569'&gt;локальные • облачные • любой вендор&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="75" y="985" width="340" height="70" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Хранилища&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569'&gt;PostgreSQL • pgvector • blob&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="445" y="985" width="340" height="70" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Коннекторы и инструменты&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569'&gt;Git • Gmail • Calendar • MCP • Home&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="815" y="985" width="340" height="70" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Наблюдаемость&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569'&gt;OpenTelemetry • eval harness&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#475569;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="1185" y="985" width="340" height="70" as="geometry"/></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c5" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c6" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="Envelope" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="события" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c12" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c24" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c22" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c22" target="c28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c26" target="c31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c27" target="c32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c28" target="c33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#334155;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c29" target="c34"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="02 — Kernel и плагины"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0" background="#F8FAFC"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;02 — Kernel и плагины&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F8FAFC;strokeColor=#F8FAFC;fontSize=28;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1520" height="44" as="geometry"/></mxCell><mxCell id="c3" value="Главное правило: plugins → contracts ← kernel. Ядро не знает ни одного конкретного плагина, а плагины не знают друг друга." style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#F8FAFC;strokeColor=#F8FAFC;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="1520" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;KERNEL — стабильно&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="125" width="460" height="560" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Task State Machine&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;состояния, переходы, checkpoints&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="85" y="175" width="410" height="68" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Event Log&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;авторитетная история, replay&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="85" y="258" width="410" height="68" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Policy Engine&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;решение по политике, версионируется&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="85" y="341" width="410" height="68" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Audit&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;append-only, hash-chain, tamper-evident&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="85" y="424" width="410" height="68" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Scheduler &amp; Budgets&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;лимиты, таймауты, cancel&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="85" y="507" width="410" height="68" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Node Registry&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;узлы и их capabilities&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="85" y="590" width="410" height="68" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;CONTRACTS — версионируемые схемы&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="570" y="125" width="460" height="560" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Envelope / Event schema&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;кто, откуда, уровень доверия&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="595" y="175" width="410" height="68" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;ToolSpec&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;имя, аргументы, риск, capability&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="595" y="258" width="410" height="68" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;AgentSpec&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#475569'&gt;промпт, tools, политика модели&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#0F172A;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="595" y="341" width="410" height="68" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&g